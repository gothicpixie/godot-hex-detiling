extends SceneTree
func _initialize()->void:
	var demo:Node=(load("res://demo.tscn") as PackedScene).instantiate()
	root.add_child(demo)
	await process_frame
	var mat:ShaderMaterial=demo.get_node("Surface").material_override
	assert(not mat.get_shader_parameter("structure_guard_enabled"))
	assert(demo.structure_guard_toggle.disabled)
	demo.blend_selector.select(1)
	demo.blend_selector.item_selected.emit(1)
	assert(mat.get_shader_parameter("paper_blend"))
	assert(not mat.get_shader_parameter("coherent_blend"))
	demo.set_texture_set(3)
	demo.set_structure(true)
	assert(mat.get_shader_parameter("structure_guard_enabled"))
	assert(mat.get_shader_parameter("structure_guard_map")!=null)
	assert(not demo.structure_guard_toggle.disabled)
	assert(demo.blend_selector.disabled)
	assert(demo.blend_selector.tooltip_text=="Protect mortar uses coherent blending")
	demo.structure_guard_toggle.button_pressed=false
	assert(not mat.get_shader_parameter("structure_guard_enabled"))
	assert(not demo.blend_selector.disabled)
	assert(demo.blend_selector.selected==1)
	assert(mat.get_shader_parameter("paper_blend"))
	assert(not mat.get_shader_parameter("coherent_blend"))
	demo.set_texture_set(4)
	assert(demo.structure_guard_toggle.disabled)
	assert(not demo.blend_selector.disabled)
	assert(mat.get_shader_parameter("structure_guard_map")==null)
	demo.set_texture_set(3)
	assert(not mat.get_shader_parameter("structure_guard_enabled"))
	demo.structure_guard_toggle.button_pressed=true
	assert(mat.get_shader_parameter("structure_guard_enabled"))
	demo.set_structure(false)
	assert(not mat.get_shader_parameter("structure_guard_enabled"))
	demo.set_structure(true)
	assert(mat.get_shader_parameter("structure_guard_enabled"))
	demo.set_texture_set(0)
	assert(not mat.get_shader_parameter("structure_guard_enabled"))
	assert(mat.get_shader_parameter("structure_guard_map")==null)
	print("PASS: guard opt-in eligibility, mask binding, unsupported reset, checkbox preference, coherent override UI and restored blend choice")
	quit()
